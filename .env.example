# ==============================================================================
# Krishi Mitra: Offline Edge Agricultural Advisory System
# Environment Configuration Template
# Target: Raspberry Pi 5 (Arm Cortex-A76, 4GB RAM)
# ==============================================================================

# Local Server Configuration
HOST=0.0.0.0
PORT=8000
EXECUTORCH_PORT=8008

# Edge Hardware Optimization Flags
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# 100% Offline Air-Gapped Operation Flags
# (Set to "1" in production to strictly forbid all outbound WAN calls)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional Cloud API Fallback Keys
# (Only utilized when running in hybrid-cloud diagnostic evaluation mode;
#  100% offline edge operation on Raspberry Pi 5 functions with zero API keys)
HUGGINGFACE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
